# Conatus Map-Server (VPS). Installation: sudo bash deploy/setup.sh
[Unit]
Description=Conatus Map Download Server (maps.json + json.php + static .sd7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conatus
Group=conatus
WorkingDirectory=/opt/conatus-map-server
Environment=PYTHONPATH=/opt/conatus-map-server
Environment=CONATUS_SNAPSHOTS_DIR=/srv/conatus-maps/snapshots
Environment=CONATUS_LOGS_DIR=/srv/conatus-maps/logs
Environment=CONATUS_ARRIVALS_DIR=/srv/conatus-maps/arrivals
# Relay-Defaults (internet-hosting); Engine kommt via deploy/setup-relay.sh.
# Fehlt das Engine-Verzeichnis, meldet /relay/health dedicated_ready=false.
Environment=CONATUS_RELAY_ENGINE_DIR=/opt/conatus-relay/engine
Environment=CONATUS_RELAY_RUN_DIR=/srv/conatus-maps/relay
Environment=CONATUS_RELAY_PORTS=8452-8461
# CONATUS_MAPS_DIR / CONATUS_SNAPSHOTS_DIR / CONATUS_LOGS_DIR / CONATUS_ARRIVALS_DIR / CONATUS_PORT / CONATUS_BASE_URL
# sowie die Zugangsdaten CONATUS_MAP_SECRET / CONATUS_MAP_TOKENS_FILE / CONATUS_LEGACY_SECRET_SCOPE:
EnvironmentFile=/etc/conatus-map-server.env
# CONATUS_MAP_SECRET steht bewusst NICHT mehr in der ExecStart-Zeile: Argumente
# landen in /proc/<pid>/cmdline und sind fuer jeden lokalen Nutzer lesbar
# (`ps aux`). Der Server liest das Secret jetzt direkt aus der Umgebung --
# /proc/<pid>/environ gehoert nur dem Prozessbesitzer.
ExecStart=/usr/bin/python3 -m map_server.server \
    --maps-dir ${CONATUS_MAPS_DIR} \
    --port ${CONATUS_PORT} \
    --base-url ${CONATUS_BASE_URL} \
    --snapshots-dir ${CONATUS_SNAPSHOTS_DIR} \
    --logs-dir ${CONATUS_LOGS_DIR} \
    --arrivals-dir ${CONATUS_ARRIVALS_DIR} \
    --relay-engine-dir ${CONATUS_RELAY_ENGINE_DIR} \
    --relay-run-dir ${CONATUS_RELAY_RUN_DIR} \
    --relay-ports ${CONATUS_RELAY_PORTS}
Restart=on-failure
RestartSec=5

# Haertung: Server liest nur Code + Maps-Verzeichnis, schreibt nirgends.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/conatus-maps
PrivateTmp=true

[Install]
WantedBy=multi-user.target
